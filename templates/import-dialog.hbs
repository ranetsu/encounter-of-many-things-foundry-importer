<form class="eomt-import-form">
  <p>
    Choose an EoMT package ZIP or Actor JSON exported by Encounter of Many
    Things. Packages can include token art and multiple Actors.
  </p>

  <div class="form-group">
    <label>EoMT Package or Actor JSON</label>
    <input type="file" name="actorFile" accept=".zip,.eomt,.json,application/zip,application/json">
  </div>

  <footer class="sheet-footer flexrow">
    <button type="button" data-action="import">
      <i class="fas fa-file-import"></i>
      Import
    </button>
  </footer>
</form>
